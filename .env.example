# Copie este archivo como .env y ajuste los valores. Nunca suba el archivo .env al repositorio.

# Llave(s) Fernet para cifrar los tokens en reposo (la primera cifra; agregue la anterior al rotar).
# «python iniciar.py» la genera sola la primera vez. A mano:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SANIBOT_TOKEN_ENCRYPTION_KEYS=

SANIBOT_SECRET_KEY=cambie-esta-clave-de-sesion
SANIBOT_ADMIN_API_KEY=cambie-esta-clave-admin
SANIBOT_OAUTH_CLIENT_SECRET=sanibot-secret
SANIBOT_SANITAS_SERVICE_KEY=clave-servicio-sanibot
SANIBOT_SANITAS_WEBHOOK_SECRET=secreto-webhook-sanitas

# Reglas de negocio
SANIBOT_OFFER_WINDOW_MINUTES=30
SANIBOT_BREAKER_MAX_PER_MINUTE=20

# WhatsApp: "console" muestra los mensajes en la consola de demostración (/demo);
# "cloud" los envía de verdad con la API de WhatsApp Cloud de Meta (ver docs/GUIA_WHATSAPP_REAL.md).
SANIBOT_WHATSAPP_MODE=console
SANIBOT_WHATSAPP_PHONE_NUMBER_ID=
SANIBOT_WHATSAPP_BUSINESS_ACCOUNT_ID=
SANIBOT_WHATSAPP_ACCESS_TOKEN=
SANIBOT_WHATSAPP_APP_SECRET=
SANIBOT_WHATSAPP_VERIFY_TOKEN=sanibot-verify-token
SANIBOT_WHATSAPP_API_VERSION=v25.0

# Opcional: dominio estático gratuito de ngrok para que la URL del webhook no cambie (python iniciar.py --tunel)
# NGROK_DOMAIN=
